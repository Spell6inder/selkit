# Serbian — the official Latin alphabet (gajica). Every letter has a pair, so it reverses exactly.

name    = Serbian Latin
name.uk = Сербська латинка
lang    = sr
base    = iso9
detect  = ђ ћ џ љ њ ј
reverse = auto

[to-latin]
а = a
б = b
в = v
г = g
д = d
ђ = đ
е = e
ж = ž
з = z
и = i
ј = j
к = k
л = l
љ = lj
м = m
н = n
њ = nj
о = o
п = p
р = r
с = s
т = t
ћ = ć
у = u
ф = f
х = h
ц = c
ч = č
џ = dž
ш = š
