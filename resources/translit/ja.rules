# Japanese kana — modified Hepburn romanization. Kanji need a dictionary and are left as they are.
# Katakana is matched by the hiragana rules; small っ doubles the next consonant (~ below), ー lengthens the
# previous vowel (- below), and long o/u get a macron: とうきょう → tōkyō, フリーレン → Furīren.

name                  = Japanese kana (Hepburn)
name.uk               = Японська кана (Гепберн)
lang                  = ja
fold-katakana         = yes
space-between-scripts = yes
capitalize-scripts    = Katakana

[to-latin]
